# Run from the project root: doxygen Doxyfile
PROJECT_NAME           = "Passvault"
INPUT                  = src tests
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp
OUTPUT_DIRECTORY       = build/docs
GENERATE_HTML          = YES
